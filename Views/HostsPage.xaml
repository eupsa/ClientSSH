<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClientSSH.Views.HostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientSSH.Views"
    xmlns:m="using:ClientSSH.Models">

    <Grid Padding="40,16,40,32" MaxWidth="1000" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Hosts_Title" Style="{StaticResource PageTitle}" />
                <TextBlock x:Uid="Hosts_Subtitle" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource BigButton}"
                    VerticalAlignment="Center" Command="{x:Bind ViewModel.AddCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="Hosts_Add" />
                </StackPanel>
            </Button>
        </Grid>

        <TeachingTip x:Uid="Tour_Step1" Target="{x:Bind AddButton}" IsOpen="{x:Bind Tour.IsStep1, Mode=OneWay}"
                     IsLightDismissEnabled="False"
                     ActionButtonCommand="{x:Bind Tour.NextCommand}" CloseButtonCommand="{x:Bind Tour.FinishCommand}" />
        <TeachingTip x:Uid="Tour_Step2" Target="{x:Bind HostList}" IsOpen="{x:Bind Tour.IsStep2, Mode=OneWay}"
                     IsLightDismissEnabled="False"
                     ActionButtonCommand="{x:Bind Tour.NextCommand}" CloseButtonCommand="{x:Bind Tour.FinishCommand}" />

        <ListView x:Name="HostList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Hosts}" SelectionMode="None"
                  ItemContainerStyle="{StaticResource HostRowContainer}">
            <ListView.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" /><AddDeleteThemeTransition /><RepositionThemeTransition /></TransitionCollection></ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:Host">
                    <Border Style="{StaticResource FeatureCard}" Padding="16"
                            PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
                        <Border.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.15" />
                        </Border.ScaleTransition>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind local:HostsPage.KindGlyph(Kind)}" FontSize="22" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}" />
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Text="{x:Bind local:HostsPage.Describe(User, Address, Port)}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind local:HostsPage.LastConnectedText(LastConnectedUtc)}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Uid="Hosts_Favorite" Click="OnFavoriteClick" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="{x:Bind local:HostsPage.StarGlyph(Favorite)}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="3" x:Uid="Hosts_ConnectButton" Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center" Click="OnConnectClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock x:Uid="Hosts_Connect" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" x:Uid="Hosts_Remove" Click="OnRemoveClick" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="28" /></TransitionCollection></StackPanel.ChildrenTransitions>
            <local:LottieView Animation="terminal-cursor" Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Hosts_EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextBrush}" />
            <TextBlock x:Uid="Hosts_EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            <Button Style="{StaticResource BigButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.AddCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="Hosts_Add" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
