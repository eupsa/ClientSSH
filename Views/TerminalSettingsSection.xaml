<?xml version="1.0" encoding="utf-8"?>
<!-- Settings section: window backdrop, terminal appearance per profile and profile shortcuts (AppearanceViewModel). -->
<UserControl
    x:Class="ClientSSH.Views.TerminalSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <StackPanel Spacing="10">
        <TextBlock x:Uid="Appearance_Section" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
        <Border Style="{StaticResource FeatureCard}" Padding="0">
            <StackPanel>
                <!-- Window backdrop -->
                <Grid Padding="20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                    <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="BackdropTitle" x:Uid="Appearance_Backdrop_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock x:Uid="Appearance_Backdrop_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="170" AutomationProperties.LabeledBy="{x:Bind BackdropTitle}"
                              SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="Appearance_Backdrop_Brand" />
                        <ComboBoxItem x:Uid="Appearance_Backdrop_Mica" />
                        <ComboBoxItem x:Uid="Appearance_Backdrop_Acrylic" />
                    </ComboBox>
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />

                <!-- Which profile is being edited -->
                <Grid Padding="20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                    <FontIcon Glyph="&#xE756;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="TargetTitle" x:Uid="Appearance_Target_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock x:Uid="Appearance_Target_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="220" ItemsSource="{x:Bind ViewModel.Targets}" DisplayMemberPath="Name"
                              AutomationProperties.LabeledBy="{x:Bind TargetTitle}"
                              SelectedIndex="{x:Bind ViewModel.TargetIndex, Mode=TwoWay}" />
                </Grid>
                <Grid Padding="20,0,20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto"
                      Visibility="{x:Bind ViewModel.IsProfileTarget, Mode=OneWay}">
                    <FontIcon Glyph="&#xE771;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CustomizeTitle" x:Uid="Appearance_Customize_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock x:Uid="Appearance_Customize_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0" AutomationProperties.LabeledBy="{x:Bind CustomizeTitle}"
                                  IsOn="{x:Bind ViewModel.Customize, Mode=TwoWay}" />
                </Grid>
                <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />

                <!-- Preview: background, text and the 16 ANSI colours of the chosen scheme -->
                <Border Margin="20,16" Padding="16,12" CornerRadius="{StaticResource ControlCornerRadius}"
                        BorderThickness="1" BorderBrush="{ThemeResource BorderBrush}"
                        Background="{x:Bind ViewModel.PreviewBackground, Mode=OneWay}">
                    <StackPanel Spacing="10" FlowDirection="LeftToRight">
                        <TextBlock x:Uid="Appearance_PreviewText" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{x:Bind ViewModel.PreviewForeground, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewColors, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="media:Brush">
                                    <Rectangle Width="20" Height="14" RadiusX="3" RadiusY="3" Fill="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <Grid Padding="20,0,20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="SchemeTitle" x:Uid="Appearance_Scheme_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Uid="Appearance_Scheme_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="220" ItemsSource="{x:Bind ViewModel.SchemeNames}"
                                  AutomationProperties.LabeledBy="{x:Bind SchemeTitle}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SchemeIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid Padding="20,0,20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto,Auto">
                        <FontIcon Glyph="&#xE8D2;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="FontTitle" x:Uid="Appearance_Font_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Uid="Appearance_Font_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="220" MaxWidth="260" ItemsSource="{x:Bind ViewModel.FontNames}"
                                  AutomationProperties.LabeledBy="{x:Bind FontTitle}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.FontIndex, Mode=TwoWay}" />
                        <NumberBox Grid.Column="3" Width="120" SmallChange="1" SpinButtonPlacementMode="Inline"
                                   AutomationProperties.LabeledBy="{x:Bind FontTitle}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                   Minimum="{x:Bind ViewModel.MinFontSize}" Maximum="{x:Bind ViewModel.MaxFontSize}"
                                   Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}" />
                    </Grid>
                    <Grid Padding="20,0,20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto,Auto">
                        <FontIcon Glyph="&#xE8AC;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="CursorTitle" x:Uid="Appearance_Cursor_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Uid="Appearance_Cursor_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="140" AutomationProperties.LabeledBy="{x:Bind CursorTitle}"
                                  IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.CursorIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Appearance_Cursor_Block" />
                            <ComboBoxItem x:Uid="Appearance_Cursor_Bar" />
                            <ComboBoxItem x:Uid="Appearance_Cursor_Underline" />
                        </ComboBox>
                        <Slider Grid.Column="3" Width="140" Minimum="5" Maximum="100" StepFrequency="5" VerticalAlignment="Center"
                                AutomationProperties.LabeledBy="{x:Bind CursorTitle}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                Value="{x:Bind ViewModel.CursorSize, Mode=TwoWay}" />
                    </Grid>
                    <Grid Padding="20,0,20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xF354;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="OpacityTitle" x:Uid="Appearance_Opacity_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Uid="Appearance_Opacity_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="2" Width="220" Maximum="100" StepFrequency="5" VerticalAlignment="Center"
                                Minimum="{x:Bind ViewModel.MinOpacity}"
                                AutomationProperties.LabeledBy="{x:Bind OpacityTitle}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                Value="{x:Bind ViewModel.Opacity, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!-- Shortcut: only for local shells -->
                <StackPanel Visibility="{x:Bind ViewModel.IsShellTarget, Mode=OneWay}">
                    <Rectangle Height="1" Fill="{ThemeResource BorderBrush}" />
                    <Grid Padding="20,16" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Glyph="&#xE765;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ShortcutTitle" x:Uid="Appearance_Shortcut_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Uid="Appearance_Shortcut_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Uid="Appearance_Shortcut_Invalid" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ErrorBrush}"
                                       Visibility="{x:Bind ViewModel.ShortcutInvalid, Mode=OneWay}" />
                        </StackPanel>
                        <TextBox Grid.Column="2" Width="180" AutomationProperties.LabeledBy="{x:Bind ShortcutTitle}"
                                 Text="{x:Bind ViewModel.Shortcut, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
