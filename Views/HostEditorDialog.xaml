<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClientSSH.Views.HostEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="Editor"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}">

    <StackPanel Spacing="12" MinWidth="360">
        <TextBox x:Uid="Editor_Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox x:Uid="Editor_Address" Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox x:Uid="Editor_User" Text="{x:Bind ViewModel.User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <NumberBox x:Uid="Editor_Port" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" Minimum="1" Maximum="65535" />
    </StackPanel>
</ContentDialog>
