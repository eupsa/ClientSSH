<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClientSSH.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientSSH.Views"
    xmlns:sessions="using:ClientSSH.Services.Sessions">

    <Grid Padding="16,4,16,16" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TabView x:Name="Tabs"
                 TabItemsSource="{x:Bind ViewModel.Sessions.Tabs}"
                 SelectedItem="{x:Bind ViewModel.Sessions.Selected, Mode=TwoWay}"
                 Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay}"
                 CanReorderTabs="True" CloseButtonOverlayMode="Auto"
                 AddTabButtonClick="OnAddTabButtonClick" TabCloseRequested="OnTabCloseRequested"
                 GettingFocus="OnTabsGettingFocus" SelectionChanged="OnTabsSelectionChanged" Tapped="OnTabsTapped" Loaded="OnTabsLoaded">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="sessions:SessionTab">
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE756;" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
            <TabView.TabStripFooter>
                <Button x:Uid="Assistant_Toggle" Command="{x:Bind Assistant.ToggleCommand}" Margin="4,0,0,0"
                        Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                </Button>
            </TabView.TabStripFooter>
        </TabView>

        <!-- The tab strip only picks the session; one view below shows the selected one, so its size is ours to control. -->
        <local:SessionView x:Name="Current" Grid.Row="1" Tab="{x:Bind ViewModel.Sessions.Selected, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasTabs, Mode=OneWay}" />

        <StackPanel Grid.RowSpan="2" Grid.ColumnSpan="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="28" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <local:LottieView Animation="running-command" Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Sessions_EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextBrush}" />
            <TextBlock x:Uid="Sessions_EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            <Button Style="{StaticResource BigButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.NewSessionCommand}">
                <TextBlock x:Uid="Sessions_EmptyButton" />
            </Button>
        </StackPanel>

        <!-- AI assistant: the answer is typed at the terminal prompt without Enter. -->
        <Border Grid.Row="1" Grid.Column="1" Width="320" Margin="0,8,0,0" Padding="16" BorderThickness="1"
                Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}"
                CornerRadius="{StaticResource CardCornerRadius}"
                Visibility="{x:Bind Assistant.IsOpen, Mode=OneWay}">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="40" />
                </TransitionCollection>
            </Border.Transitions>
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Assistant_Title" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                    <TextBlock x:Uid="Assistant_Privacy" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBox x:Name="PromptBox" x:Uid="Assistant_Prompt" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="72"
                             Text="{x:Bind Assistant.Prompt, Mode=TwoWay}" KeyDown="OnPromptKeyDown" />
                    <Button x:Uid="Assistant_Send" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{x:Bind Assistant.AskCommand}" IsEnabled="{x:Bind Assistant.IsNotBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Assistant.Status, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <Expander x:Uid="Assistant_Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <ComboBox x:Uid="Assistant_Provider" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind Assistant.ProviderNames}"
                                      SelectedIndex="{x:Bind Assistant.ProviderIndex, Mode=TwoWay}" />
                            <TextBox x:Uid="Assistant_Model" Text="{x:Bind Assistant.Model, Mode=TwoWay}"
                                     PlaceholderText="{x:Bind Assistant.ModelPlaceholder, Mode=OneWay}" />
                            <PasswordBox x:Uid="Assistant_Key" Password="{x:Bind Assistant.ApiKey, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="Assistant_SaveKey" Command="{x:Bind Assistant.SaveKeyCommand}" />
                                <Button x:Uid="Assistant_RemoveKey" Command="{x:Bind Assistant.RemoveKeyCommand}"
                                        IsEnabled="{x:Bind Assistant.HasKey, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock x:Uid="Assistant_HasKey" FontSize="12" Foreground="{ThemeResource AccentForegroundBrush}"
                                       Visibility="{x:Bind Assistant.HasKey, Mode=OneWay}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TeachingTip x:Uid="Tour_Step3" Target="{x:Bind Tabs}" IsOpen="{x:Bind Tour.IsStep3, Mode=OneWay}"
                     IsLightDismissEnabled="False"
                     ActionButtonCommand="{x:Bind Tour.NextCommand}" CloseButtonCommand="{x:Bind Tour.FinishCommand}" />
    </Grid>
</Page>
