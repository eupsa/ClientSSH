<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClientSSH.Views.SessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientSSH.Views"
    Unloaded="OnUnloaded">

    <Grid>
        <Border Padding="16" BorderThickness="1"
                Background="{ThemeResource TerminalBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}"
                CornerRadius="{StaticResource CardCornerRadius}">
            <local:TerminalView x:Name="Terminal" GotFocus="OnTerminalGotFocus" />
        </Border>

        <!-- Focused pane of a split tab: accent outline over the card, never hit-testable. -->
        <Border BorderThickness="2" BorderBrush="{ThemeResource AccentForegroundBrush}" IsHitTestVisible="False"
                CornerRadius="{StaticResource CardCornerRadius}"
                Visibility="{x:Bind local:SessionView.FocusVisibility(Pane.IsFocused, ShowFocus), Mode=OneWay}" />

        <!-- Centered status animation: connecting until the first output, then a short "connected". -->
        <!-- x:Load: the animations only exist while shown, instead of two players per open pane. -->
        <local:LottieView x:Name="ConnectingAnimation" x:Load="{x:Bind Pane.IsConnecting, Mode=OneWay}"
                          Animation="{x:Bind Pane.ConnectingAnimation, Mode=OneWay}" Width="120" Height="120"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        <local:LottieView x:Name="ConnectedAnimation" x:Load="{x:Bind Pane.JustConnected, Mode=OneWay}"
                          Animation="connected" Loop="False" Width="120" Height="120"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

        <InfoBar VerticalAlignment="Bottom" Margin="16" IsClosable="False"
                 IsOpen="{x:Bind Pane.HasNotice, Mode=OneWay}"
                 Severity="{x:Bind local:SessionView.SeverityFor(Pane.NoticeIsError), Mode=OneWay}"
                 Message="{x:Bind Pane.Notice, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Uid="Terminal_Reconnect" Click="OnReconnectClick" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</UserControl>
