<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClientSSH.Views.SessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClientSSH.Views">

    <Grid>
        <Border Margin="0,8,0,0" Padding="16" BorderThickness="1"
                Background="{ThemeResource TerminalBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}"
                CornerRadius="{StaticResource CardCornerRadius}">
            <local:TerminalView x:Name="Terminal" />
        </Border>

        <!-- Centered status animation: connecting until the first output, then a short "connected". -->
        <!-- x:Load: the animations only exist while shown, instead of two players per open tab. -->
        <local:LottieView x:Name="ConnectingAnimation" x:Load="{x:Bind Tab.IsConnecting, Mode=OneWay}"
                          Animation="{x:Bind Tab.ConnectingAnimation, Mode=OneWay}" Width="120" Height="120"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        <local:LottieView x:Name="ConnectedAnimation" x:Load="{x:Bind Tab.JustConnected, Mode=OneWay}"
                          Animation="connected" Loop="False" Width="120" Height="120"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

        <InfoBar VerticalAlignment="Bottom" Margin="16" IsClosable="False"
                 IsOpen="{x:Bind Tab.HasNotice, Mode=OneWay}"
                 Severity="{x:Bind local:SessionView.SeverityFor(Tab.NoticeIsError), Mode=OneWay}"
                 Message="{x:Bind Tab.Notice, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Uid="Terminal_Reconnect" Click="OnReconnectClick" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</UserControl>
