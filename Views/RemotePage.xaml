<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClientSSH.Views.RemotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- This PC's number, and calling another PC. Hidden while watching. -->
        <ScrollViewer Visibility="{x:Bind Remote.IsNotViewing, Mode=OneWay}">
            <StackPanel MaxWidth="820" Padding="40,16,40,40" Spacing="20" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="28" /></TransitionCollection></StackPanel.ChildrenTransitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Remote_Title" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                    <TextBlock x:Uid="Remote_Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <InfoBar x:Uid="Remote_NatWarning" Severity="Warning" IsClosable="False" IsOpen="{x:Bind Remote.NetworkWarning, Mode=OneWay}" />

                <!-- This PC -->
                <Border Style="{StaticResource FeatureCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Uid="Remote_MyPc_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Uid="Remote_MyPc_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind Remote.MyNumber, Mode=OneWay}" IsTextSelectionEnabled="True" FontSize="36" FontWeight="SemiBold"
                                       FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource AccentForegroundBrush}" VerticalAlignment="Center" />
                            <Button x:Uid="Remote_Copy" Click="OnCopyNumber" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="Remote_Listen" IsOn="{x:Bind Remote.Listening, Mode=TwoWay}" />
                        <TextBlock x:Uid="Remote_Listen_Hint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Access another PC -->
                <Border Style="{StaticResource FeatureCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE71B;" FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Uid="Remote_Join_Title" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Uid="Remote_Join_Desc" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Uid="Remote_Number" Width="240" FontFamily="Cascadia Mono, Consolas" FontSize="20" KeyDown="OnNumberKeyDown"
                                     Text="{x:Bind Remote.NumberInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind Remote.IsIdle, Mode=OneWay}" />
                            <Button x:Uid="Remote_JoinButton" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"
                                    Command="{x:Bind Remote.ConnectCommand}" IsEnabled="{x:Bind Remote.IsIdle, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Remote.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Remote.SecurityText, Mode=OneWay}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentForegroundBrush}"
                               Visibility="{x:Bind Remote.HasSecurityCode, Mode=OneWay}" />
                    <Button x:Uid="Remote_Stop" Command="{x:Bind Remote.StopCommand}" HorizontalAlignment="Left"
                            Visibility="{x:Bind Remote.HasSession, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Watching: the other PC's screen. Mouse and keyboard go to it while this is focused. -->
        <Grid Visibility="{x:Bind Remote.IsViewing, Mode=OneWay}" Padding="16,8,16,16" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                <Button x:Uid="Remote_Disconnect" Command="{x:Bind Remote.StopCommand}" />
                <TextBlock Text="{x:Bind Remote.AccessText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind Remote.SecurityText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource AccentForegroundBrush}" />
            </StackPanel>
            <Border x:Name="Surface" Grid.Row="1" IsTabStop="True" UseSystemFocusVisuals="False" CornerRadius="{StaticResource CardCornerRadius}"
                    Background="{ThemeResource TerminalBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                    KeyDown="OnSurfaceKeyDown" KeyUp="OnSurfaceKeyUp"
                    PointerMoved="OnSurfacePointerMoved" PointerPressed="OnSurfacePointerPressed"
                    PointerReleased="OnSurfacePointerReleased" PointerWheelChanged="OnSurfaceWheel" />
        </Grid>
    </Grid>
</Page>
