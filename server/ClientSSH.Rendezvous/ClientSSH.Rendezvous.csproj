<Project Sdk="Microsoft.NET.Sdk">
  <!-- The optional "introducer" for short remote-access codes. Console app, no UI, no dependencies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Services\Remote\Rendezvous.cs" Link="Rendezvous.cs" />
    <Compile Include="..\..\Services\Remote\RemoteCode.cs" Link="RemoteCode.cs" />
  </ItemGroup>
</Project>
