  <data name="Tour_Step2.Title" xml:space="preserve"><value>Demo-Host</value></data>
  <data name="Tour_Step2.Subtitle" xml:space="preserve"><value>Dieser Host wird in der App simuliert, ohne Netzwerk, nur für die Tour. Er verschwindet, wenn die Tour endet.</value></data>
