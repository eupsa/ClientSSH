  <data name="Tour_Step3.CloseButtonContent" xml:space="preserve"><value>Tour überspringen</value></data>
  <data name="Tour_Step4.Title" xml:space="preserve"><value>Seitenleiste</value></data>
  <data name="Tour_Step4.Subtitle" xml:space="preserve"><value>Beim Verbinden wird die Seitenleiste eingeklappt, um Platz für das Terminal zu schaffen. Mit diesem Symbol kehren Sie zur Hostliste zurück.</value></data>
  <data name="Tour_Step4.ActionButtonContent" xml:space="preserve"><value>Fertig</value></data>
