  <data name="Tour_Step1.Title" xml:space="preserve"><value>अपने होस्ट जोड़ें</value></data>
  <data name="Tour_Step1.Subtitle" xml:space="preserve"><value>होस्ट जोड़ने के लिए यहाँ क्लिक करें। सब कुछ केवल इसी पीसी पर सहेजा जाता है।</value></data>
  <data name="Tour_Step1.ActionButtonContent" xml:space="preserve"><value>आगे</value></data>
  <data name="Tour_Step1.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
  <data name="Tour_Step2.Title" xml:space="preserve"><value>डेमो होस्ट</value></data>
  <data name="Tour_Step2.Subtitle" xml:space="preserve"><value>यह होस्ट केवल टूर के लिए, बिना नेटवर्क के, ऐप के अंदर सिमुलेट किया गया है। टूर खत्म होने पर यह गायब हो जाता है।</value></data>
  <data name="Tour_Step2.ActionButtonContent" xml:space="preserve"><value>डेमो से कनेक्ट करें</value></data>
  <data name="Tour_Step2.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
  <data name="Tour_Step3.Title" xml:space="preserve"><value>टर्मिनल</value></data>
  <data name="Tour_Step3.Subtitle" xml:space="preserve"><value>यहाँ कमांड लिखें। help, ls या pwd आज़माएँ और Enter दबाएँ।</value></data>
  <data name="Tour_Step3.ActionButtonContent" xml:space="preserve"><value>आगे</value></data>
  <data name="Tour_Step3.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
  <data name="Tour_Step4.Title" xml:space="preserve"><value>साइडबार</value></data>
  <data name="Tour_Step4.Subtitle" xml:space="preserve"><value>कनेक्ट करने पर टर्मिनल के लिए जगह बनाने हेतु साइडबार सिकुड़ जाता है। होस्ट सूची पर लौटने के लिए इस आइकन का उपयोग करें।</value></data>
  <data name="Tour_Step4.ActionButtonContent" xml:space="preserve"><value>समाप्त</value></data>
  <data name="Tour_Step4.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
  <data name="Demo_HostName" xml:space="preserve"><value>डेमो होस्ट</value></data>
  <data name="Demo_Banner" xml:space="preserve"><value>सिमुलेटेड सत्र: कुछ भी आपके पीसी से बाहर नहीं जाता। कमांड देखने के लिए help लिखें।</value></data>
  <data name="Demo_Help" xml:space="preserve"><value>उपलब्ध कमांड: help, ls, pwd, whoami, hostname, echo, clear, exit</value></data>
  <data name="Demo_NotFound" xml:space="preserve"><value>कमांड नहीं मिला (यह एक सिमुलेटेड सत्र है)</value></data>
  <data name="Hosts_Subtitle.Text" xml:space="preserve"><value>आपके सर्वर, केवल इसी पीसी पर सहेजे गए।</value></data>
  <data name="Hosts_EmptyTitle.Text" xml:space="preserve"><value>अभी कोई होस्ट नहीं है</value></data>
  <data name="Hosts_EmptyBody.Text" xml:space="preserve"><value>कुछ ही क्लिक में SSH से कनेक्ट करने के लिए अपना पहला होस्ट जोड़ें।</value></data>
