  <data name="Tour_Step1.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
  <data name="Tour_Step2.Title" xml:space="preserve"><value>डेमो होस्ट</value></data>
  <data name="Tour_Step2.Subtitle" xml:space="preserve"><value>यह होस्ट केवल टूर के लिए, बिना नेटवर्क के, ऐप के अंदर सिमुलेट किया गया है। टूर खत्म होने पर यह गायब हो जाता है।</value></data>
  <data name="Tour_Step2.ActionButtonContent" xml:space="preserve"><value>डेमो से कनेक्ट करें</value></data>
  <data name="Tour_Step2.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
