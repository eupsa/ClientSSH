  <data name="Tour_Step3.Subtitle" xml:space="preserve"><value>यहाँ कमांड लिखें। help, ls या pwd आज़माएँ और Enter दबाएँ।</value></data>
  <data name="Tour_Step3.ActionButtonContent" xml:space="preserve"><value>आगे</value></data>
  <data name="Tour_Step3.CloseButtonContent" xml:space="preserve"><value>टूर छोड़ें</value></data>
  <data name="Tour_Step4.Title" xml:space="preserve"><value>साइडबार</value></data>
  <data name="Tour_Step4.Subtitle" xml:space="preserve"><value>कनेक्ट करने पर टर्मिनल के लिए जगह बनाने हेतु साइडबार सिकुड़ जाता है। होस्ट सूची पर लौटने के लिए इस आइकन का उपयोग करें।</value></data>
  <data name="Tour_Step4.ActionButtonContent" xml:space="preserve"><value>समाप्त</value></data>
