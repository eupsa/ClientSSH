  <data name="Tour_Step1.Subtitle" xml:space="preserve"><value>여기를 클릭하여 호스트를 추가하세요. 모든 내용은 이 PC에만 저장됩니다.</value></data>
  <data name="Tour_Step1.ActionButtonContent" xml:space="preserve"><value>다음</value></data>
