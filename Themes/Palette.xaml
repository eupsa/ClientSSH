            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource AccentForegroundColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentForegroundColor}" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource AccentForegroundColor}" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource AccentColor}" />
        </ResourceDictionary>
