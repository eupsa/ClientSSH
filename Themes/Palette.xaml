            <Color x:Key="AccentTextColor">#FFFFFF</Color>
            <Color x:Key="AccentForegroundColor">#1E3A8A</Color>
            <Color x:Key="BackgroundGlowColor">#E8EEFC</Color>
            <Color x:Key="SplashBackgroundColor">#0F1F57</Color>
            <Color x:Key="ErrorColor">#C62839</Color>
            <Color x:Key="TerminalBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TerminalForegroundColor">#05070D</Color>
            <Color x:Key="TerminalCursorColor">#1E3A8A</Color>
            <Color x:Key="TerminalSelectionColor">#C9D3EE</Color>
            <Color x:Key="Ansi0Color">#05070D</Color>
            <Color x:Key="Ansi1Color">#C62839</Color>
            <Color x:Key="Ansi2Color">#0E8F5A</Color>
            <Color x:Key="Ansi3Color">#9A6B00</Color>
            <Color x:Key="Ansi4Color">#1E3A8A</Color>
            <Color x:Key="Ansi5Color">#7B3FA0</Color>
            <Color x:Key="Ansi6Color">#0F7F9C</Color>
            <Color x:Key="Ansi7Color">#44506E</Color>
            <Color x:Key="Ansi8Color">#6B7599</Color>
            <Color x:Key="Ansi9Color">#FF5D6C</Color>
            <Color x:Key="Ansi10Color">#12B870</Color>
            <Color x:Key="Ansi11Color">#C48A00</Color>
            <Color x:Key="Ansi12Color">#2747A6</Color>
            <Color x:Key="Ansi13Color">#9B5FC4</Color>
            <Color x:Key="Ansi14Color">#1A9DBD</Color>
            <Color x:Key="Ansi15Color">#8A93B5</Color>
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
            <SolidColorBrush x:Key="BackgroundGlowBrush" Color="{StaticResource BackgroundGlowColor}" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="{StaticResource SplashBackgroundColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
            <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{StaticResource TerminalBackgroundColor}" />
            <SolidColorBrush x:Key="TerminalForegroundBrush" Color="{StaticResource TerminalForegroundColor}" />
            <SolidColorBrush x:Key="TerminalCursorBrush" Color="{StaticResource TerminalCursorColor}" />
            <SolidColorBrush x:Key="TerminalSelectionBrush" Color="{StaticResource TerminalSelectionColor}" />
            <SolidColorBrush x:Key="Ansi0Brush" Color="{StaticResource Ansi0Color}" />
            <SolidColorBrush x:Key="Ansi1Brush" Color="{StaticResource Ansi1Color}" />
            <SolidColorBrush x:Key="Ansi2Brush" Color="{StaticResource Ansi2Color}" />
            <SolidColorBrush x:Key="Ansi3Brush" Color="{StaticResource Ansi3Color}" />
            <SolidColorBrush x:Key="Ansi4Brush" Color="{StaticResource Ansi4Color}" />
            <SolidColorBrush x:Key="Ansi5Brush" Color="{StaticResource Ansi5Color}" />
            <SolidColorBrush x:Key="Ansi6Brush" Color="{StaticResource Ansi6Color}" />
            <SolidColorBrush x:Key="Ansi7Brush" Color="{StaticResource Ansi7Color}" />
            <SolidColorBrush x:Key="Ansi8Brush" Color="{StaticResource Ansi8Color}" />
            <SolidColorBrush x:Key="Ansi9Brush" Color="{StaticResource Ansi9Color}" />
            <SolidColorBrush x:Key="Ansi10Brush" Color="{StaticResource Ansi10Color}" />
            <SolidColorBrush x:Key="Ansi11Brush" Color="{StaticResource Ansi11Color}" />
            <SolidColorBrush x:Key="Ansi12Brush" Color="{StaticResource Ansi12Color}" />
            <SolidColorBrush x:Key="Ansi13Brush" Color="{StaticResource Ansi13Color}" />
            <SolidColorBrush x:Key="Ansi14Brush" Color="{StaticResource Ansi14Color}" />
            <SolidColorBrush x:Key="Ansi15Brush" Color="{StaticResource Ansi15Color}" />
            <!-- Derived surfaces and the WinUI accent keys, so every stock control follows the brand accent. -->
            <Color x:Key="AccentSoftColor">#261E3A8A</Color>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
                <GradientStop Color="{StaticResource BackgroundGlowColor}" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentColor}" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource SurfaceColor}" />
            <!-- Stock controls copy the accent into their own keys at load time, so override those too. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AccentColor}" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AccentColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource AccentTextColor}" Opacity="0.8" />
